{
  "$defs": {
    "AnalyzeForm": {
      "additionalProperties": false,
      "description": "Form fields of POST /items/analyze (multipart), besides the `image` file part.\n\nNot a JSON body; published so the backend can validate the form and the frontend can\ntype it. An invalid category/garment_type pair is a 400 invalid_request.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "garment_type": {
          "$ref": "#/$defs/GarmentType"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "item_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Name"
        }
      },
      "required": [
        "category",
        "garment_type"
      ],
      "title": "AnalyzeForm",
      "type": "object"
    },
    "AnalyzeResponse": {
      "additionalProperties": false,
      "description": "POST /items/analyze. Persists nothing; exactly three candidates, index 0..2 in order.",
      "properties": {
        "temp_handle": {
          "pattern": "^tmp_[0-9a-f]{12}$",
          "title": "Temp Handle",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "temp_handle",
        "candidates"
      ],
      "title": "AnalyzeResponse",
      "type": "object"
    },
    "Avatar": {
      "additionalProperties": false,
      "description": "GET /avatar/{avatar_id}",
      "properties": {
        "avatar_id": {
          "pattern": "^avatar_[0-9a-f]{6}$",
          "title": "Avatar Id",
          "type": "string"
        },
        "wireframe_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Wireframe Url",
          "type": "string"
        },
        "avatar_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Avatar Url",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "avatar_id",
        "wireframe_url",
        "avatar_url",
        "created_at"
      ],
      "title": "Avatar",
      "type": "object"
    },
    "AvatarScanResponse": {
      "additionalProperties": false,
      "description": "POST /avatar/scan (multipart: image). A pose failure is 422 pose_rejected with an actionable message.",
      "properties": {
        "avatar_id": {
          "pattern": "^avatar_[0-9a-f]{6}$",
          "title": "Avatar Id",
          "type": "string"
        },
        "wireframe_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Wireframe Url",
          "type": "string"
        },
        "avatar_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Avatar Url",
          "type": "string"
        }
      },
      "required": [
        "avatar_id",
        "wireframe_url",
        "avatar_url"
      ],
      "title": "AvatarScanResponse",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "maximum": 2,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "variant": {
          "$ref": "#/$defs/CandidateVariant"
        },
        "cutout_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Cutout Url",
          "type": "string"
        },
        "primary_color": {
          "$ref": "#/$defs/ExtractedColor"
        },
        "secondary_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractedColor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "index",
        "variant",
        "cutout_url",
        "primary_color"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateVariant": {
      "description": "V-S3: the three analyze candidates, in index order 0, 1, 2.",
      "enum": [
        "tight",
        "balanced",
        "generous"
      ],
      "title": "CandidateVariant",
      "type": "string"
    },
    "Category": {
      "description": "Which swipe list an item lands in and how outfit assembly treats it.",
      "enum": [
        "tops",
        "bottoms",
        "jackets"
      ],
      "title": "Category",
      "type": "string"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "not_found",
        "pose_rejected",
        "no_person_detected",
        "unsupported_image",
        "analyze_failed",
        "handle_expired",
        "gemini_unavailable",
        "not_implemented",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "Every 4xx/5xx response body.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "ExtractedColor": {
      "additionalProperties": false,
      "description": "One extracted color (V-C1..V-C5). Numeric values are the truth; names are a lookup.",
      "properties": {
        "lab": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lab",
          "type": "array"
        },
        "lch": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lch",
          "type": "array"
        },
        "hex": {
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Hex",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "is_neutral": {
          "title": "Is Neutral",
          "type": "boolean"
        },
        "everyday_neutral": {
          "title": "Everyday Neutral",
          "type": "boolean"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "lab",
        "lch",
        "hex",
        "name",
        "family",
        "is_neutral",
        "everyday_neutral"
      ],
      "title": "ExtractedColor",
      "type": "object"
    },
    "FamilyShare": {
      "additionalProperties": false,
      "description": "One colors.json family's presence in the closet, by item primary color.",
      "properties": {
        "family": {
          "title": "Family",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        },
        "hex": {
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Hex",
          "type": "string"
        }
      },
      "required": [
        "family",
        "count",
        "share",
        "hex"
      ],
      "title": "FamilyShare",
      "type": "object"
    },
    "GarmentType": {
      "description": "Which pose region vision segments. A dress is category tops, garment_type dress.",
      "enum": [
        "shirt",
        "dress",
        "pants",
        "skirt",
        "shorts",
        "jacket",
        "coat"
      ],
      "title": "GarmentType",
      "type": "string"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "db": {
          "const": "ok",
          "title": "Db",
          "type": "string"
        }
      },
      "required": [
        "status",
        "db"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "description": "A saved closet item. GET /items/{slug}, POST /items/save, and each entry of GET /items.",
      "properties": {
        "id": {
          "pattern": "^[a-z]+_[0-9a-f]{6}$",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "garment_type": {
          "$ref": "#/$defs/GarmentType"
        },
        "cutout_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Cutout Url",
          "type": "string"
        },
        "primary_color": {
          "$ref": "#/$defs/ExtractedColor"
        },
        "secondary_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractedColor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retailer_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retailer Color"
        },
        "retailer_item_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retailer Item Name"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "garment_type",
        "cutout_url",
        "primary_color",
        "created_at"
      ],
      "title": "Item",
      "type": "object"
    },
    "ItemListResponse": {
      "additionalProperties": false,
      "description": "GET /items?category=tops|bottoms|jackets. Stable order: created_at, newest first.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ItemListResponse",
      "type": "object"
    },
    "Outfit": {
      "additionalProperties": false,
      "description": "bottom + (top or dress) + optional jacket (S-O1..S-O3).",
      "properties": {
        "outfit_id": {
          "pattern": "^outfit_[0-9a-f]{6}$",
          "title": "Outfit Id",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/Strategy"
        },
        "top_id": {
          "pattern": "^(top|dress)_[0-9a-f]{6}$",
          "title": "Top Id",
          "type": "string"
        },
        "bottom_id": {
          "pattern": "^bottom_[0-9a-f]{6}$",
          "title": "Bottom Id",
          "type": "string"
        },
        "jacket_id": {
          "anyOf": [
            {
              "pattern": "^jacket_[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jacket Id"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "outfit_id",
        "strategy",
        "top_id",
        "bottom_id",
        "explanation",
        "score"
      ],
      "title": "Outfit",
      "type": "object"
    },
    "OutfitStyle": {
      "description": "2.5.0: optional preset for POST /outfits/generate (never free text).",
      "enum": [
        "casual",
        "going_out",
        "business",
        "monochrome"
      ],
      "title": "OutfitStyle",
      "type": "string"
    },
    "OutfitsGenerateRequest": {
      "additionalProperties": false,
      "description": "POST /outfits/generate. The body may be {} (limit defaults to 5). 2.5.0 (additive): optional\n`style` preset; omitted or null means the usual random pick among the best outfits.",
      "properties": {
        "limit": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutfitStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OutfitsGenerateRequest",
      "type": "object"
    },
    "OutfitsGenerateResponse": {
      "additionalProperties": false,
      "description": "Up to 5 outfits, best first. Fewer (or none, for an unsatisfiable closet) is normal.",
      "properties": {
        "outfits": {
          "items": {
            "$ref": "#/$defs/Outfit"
          },
          "maxItems": 5,
          "title": "Outfits",
          "type": "array"
        }
      },
      "required": [
        "outfits"
      ],
      "title": "OutfitsGenerateResponse",
      "type": "object"
    },
    "PaletteInsights": {
      "additionalProperties": false,
      "description": "GET /insights/palette: closet-wide color summary for the palette page (styling lane).",
      "properties": {
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "neutral_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Neutral Share",
          "type": "number"
        },
        "families": {
          "items": {
            "$ref": "#/$defs/FamilyShare"
          },
          "title": "Families",
          "type": "array"
        },
        "swatches": {
          "items": {
            "$ref": "#/$defs/PaletteSwatch"
          },
          "title": "Swatches",
          "type": "array"
        },
        "missing_families": {
          "items": {
            "type": "string"
          },
          "title": "Missing Families",
          "type": "array"
        },
        "insights": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Insights",
          "type": "array"
        },
        "most_versatile": {
          "items": {
            "$ref": "#/$defs/VersatileItem"
          },
          "maxItems": 3,
          "title": "Most Versatile",
          "type": "array"
        }
      },
      "required": [
        "item_count",
        "neutral_share",
        "families",
        "swatches",
        "missing_families",
        "insights",
        "most_versatile"
      ],
      "title": "PaletteInsights",
      "type": "object"
    },
    "PaletteSwatch": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[a-z]+_[0-9a-f]{6}$",
          "title": "Item Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "hex": {
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Hex",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "family": {
          "title": "Family",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "category",
        "hex",
        "family"
      ],
      "title": "PaletteSwatch",
      "type": "object"
    },
    "RejectRequest": {
      "additionalProperties": false,
      "description": "POST /items/reject. Nothing persists; the rejection is logged.",
      "properties": {
        "temp_handle": {
          "pattern": "^tmp_[0-9a-f]{12}$",
          "title": "Temp Handle",
          "type": "string"
        }
      },
      "required": [
        "temp_handle"
      ],
      "title": "RejectRequest",
      "type": "object"
    },
    "RejectResponse": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "title": "RejectResponse",
      "type": "object"
    },
    "RenameRequest": {
      "additionalProperties": false,
      "description": "PATCH /items/{slug}. Edits a saved item: its display name (retailer_item_name) and/or its\nfree-form details (attributes). 2.3.0 added `name`; 2.4.0 (additive) made it optional and added\n`attributes`: merged into the stored map, any value is allowed (unknown words are fine), and an\nempty string removes that key. The id and all other stored data never change.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "attributes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attributes"
        }
      },
      "title": "RenameRequest",
      "type": "object"
    },
    "RenderJob": {
      "additionalProperties": false,
      "description": "POST /render and GET /render/{render_id}. local_url is always present and correct;\ngenerated_url is set exactly when status is done.",
      "properties": {
        "render_id": {
          "pattern": "^render_[0-9a-f]{12}$",
          "title": "Render Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RenderStatus"
        },
        "local_url": {
          "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
          "title": "Local Url",
          "type": "string"
        },
        "generated_url": {
          "anyOf": [
            {
              "pattern": "^/media/[a-z]+/[0-9a-zA-Z_.-]+\\.png$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated Url"
        }
      },
      "required": [
        "render_id",
        "status",
        "local_url"
      ],
      "title": "RenderJob",
      "type": "object"
    },
    "RenderRequest": {
      "additionalProperties": false,
      "description": "POST /render",
      "properties": {
        "avatar_id": {
          "pattern": "^avatar_[0-9a-f]{6}$",
          "title": "Avatar Id",
          "type": "string"
        },
        "top_id": {
          "pattern": "^(top|dress)_[0-9a-f]{6}$",
          "title": "Top Id",
          "type": "string"
        },
        "bottom_id": {
          "pattern": "^bottom_[0-9a-f]{6}$",
          "title": "Bottom Id",
          "type": "string"
        },
        "jacket_id": {
          "anyOf": [
            {
              "pattern": "^jacket_[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jacket Id"
        }
      },
      "required": [
        "avatar_id",
        "top_id",
        "bottom_id"
      ],
      "title": "RenderRequest",
      "type": "object"
    },
    "RenderStatus": {
      "enum": [
        "pending",
        "done",
        "failed"
      ],
      "title": "RenderStatus",
      "type": "string"
    },
    "SaveRequest": {
      "additionalProperties": false,
      "description": "POST /items/save. category/garment_type/retailer fields were captured at analyze.",
      "properties": {
        "temp_handle": {
          "pattern": "^tmp_[0-9a-f]{12}$",
          "title": "Temp Handle",
          "type": "string"
        },
        "candidate_index": {
          "maximum": 2,
          "minimum": 0,
          "title": "Candidate Index",
          "type": "integer"
        }
      },
      "required": [
        "temp_handle",
        "candidate_index"
      ],
      "title": "SaveRequest",
      "type": "object"
    },
    "Strategy": {
      "description": "S-S2 outfit strategies, in degradation-ladder order.",
      "enum": [
        "neutral_anchor",
        "everyday_neutral_base",
        "analogous",
        "complementary",
        "monochrome_highlight",
        "sandwich"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "VersatileItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[a-z]+_[0-9a-f]{6}$",
          "title": "Item Id",
          "type": "string"
        },
        "outfit_count": {
          "minimum": 0,
          "title": "Outfit Count",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "outfit_count"
      ],
      "title": "VersatileItem",
      "type": "object"
    }
  },
  "title": "Atelier contract 2.5.0"
}
