{
  "_meta": {
    "purpose": "Single source of truth for mapping numeric colors to basic named colors. Read by the vision lane (naming extracted colors, everyday-neutral flag, retailer color agreement check) and the styling lane (harmony families, neutral rules).",
    "owner": "PM. Read-only to all lane subagents.",
    "frozen_with": "contract/FROZEN",
    "color_space": "CIELAB (D65, 2-degree observer). All values L*, a*, b*.",
    "assignment_rule": "Nearest center by CIEDE2000. If the nearest center exceeds max_assignment_delta_e, name resolves to 'unmapped' and the numeric value is still stored and scored.",
    "max_assignment_delta_e": 25,
    "is_neutral_note": "is_neutral is NEVER read from this file. It is computed numerically from chroma per contract. This table sets everyday_neutral only. If a name lookup and the chroma computation disagree, the chroma computation wins.",
    "calibration_warning": "These centers are starting values. They MUST be validated against the 20-image fixture set before the styling lane's 12 expectations are re-verified. Once those expectations are re-verified, changing any center invalidates them and requires re-verification."
  },

